# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=avaliance
DB_USERNAME=copilot
DB_PASSWORD=your_strong_db_password_here

# ==========================================
# Security & JWT
# ==========================================
# Must be at least 64 characters long for HS256!
JWT_SECRET=generate_a_very_long_and_secure_random_string_here_for_production
JWT_EXPIRATION_MS=86400000

# ==========================================
# Bootstrap Admin User
# ==========================================
# Will be created automatically on startup if it doesn't exist
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here

# ==========================================
# IA Service (FastAPI) Configuration
# ==========================================
IA_SERVICE_URL=http://localhost:8000
INTERNAL_TOKEN=your_secure_internal_token_here
IA_CONNECT_TIMEOUT_MS=5000
IA_READ_TIMEOUT_MS=120000

# Set to true to run backend without FastAPI (returns stub data)
IA_STUB_ENABLED=false

# ==========================================
# Web & CORS
# ==========================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
