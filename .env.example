# =============================================================================
# Avaliance Copilot — Root Environment Variables
# =============================================================================
# Copy this file to .env before running: cp .env.example .env
# Replace placeholder values for production. NEVER commit the .env file.
# =============================================================================

# =============================================
# PostgreSQL (shared by Compose and Spring Boot)
# =============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=avaliance
DB_USERNAME=copilot
DB_PASSWORD=change_me_db_password

# PostgreSQL URL used by FastAPI (Spring Boot consumes the DB_* variables above)
DATABASE_URL=postgresql://copilot:change_me_db_password@postgres:5432/avaliance

# =============================================
# Security & JWT (Backend)
# =============================================
# Must be at least 64 characters for HS256
JWT_SECRET=change_me_generate_a_very_long_and_secure_random_string_at_least_64_chars
JWT_EXPIRATION_MS=86400000

# =============================================
# Bootstrap Admin User
# =============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

# =============================================
# Internal Service-to-Service Token
# =============================================
# Shared between Spring Boot and FastAPI for X-Internal-Token header
INTERNAL_TOKEN=change_me_internal_service_secret

# =============================================
# IA Service (FastAPI) — called by Spring Boot
# =============================================
IA_SERVICE_URL=http://service-ia:8000
IA_CONNECT_TIMEOUT_MS=5000
IA_READ_TIMEOUT_MS=660000
# Set to true only for isolated backend development without FastAPI
IA_STUB_ENABLED=false

# =============================================
# Ollama (self-hosted LLM; base Compose requires NVIDIA GPU)
# =============================================
OLLAMA_URL=http://ollama:11434
# Required generation model. FastAPI readiness fails if this exact tag is unavailable.
LLM_MODEL=qwen3:8b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_NUM_CTX=8192
MIN_SOURCE_SIMILARITY=0.55

# Retrieval and grounded-generation defaults. Twenty evidence chunks support
# enumerative questions while remaining within the 8192-token model context.
GENERATION_MAX_TOKENS=1500
GENERATION_MAX_CONTEXT_CHUNKS=20
GENERATION_ANSWER_MODE=evidence_json
GENERATION_USE_DETERMINISTIC_EXTRACTORS=true

# Retrieval-only LLM context (50-100 words per chunk). It is embedded alongside,
# but never stored as source text; reindex existing documents after enabling.
CONTEXTUAL_RETRIEVAL_ENABLED=true
CONTEXTUAL_RETRIEVAL_MAX_TOKENS=120

# Hybrid retrieval defaults (benchmark 30/50/75/100 before changing production)
RETRIEVAL_CANDIDATE_LIMIT=50
RETRIEVAL_RERANK_LIMIT=30
RETRIEVAL_RRF_K=60
RETRIEVAL_VECTOR_WEIGHT=1.0
RETRIEVAL_TEXT_WEIGHT=1.0
# Requires pgvector 0.8+; applied with SET LOCAL to each vector-search transaction.
RETRIEVAL_HNSW_EF_SEARCH=100
RETRIEVAL_HNSW_ITERATIVE_SCAN=strict_order
RETRIEVAL_RERANK_LEXICAL_BONUS=0.0
RETRIEVAL_LEXICAL_EVIDENCE_RESERVE=5
RETRIEVAL_EVIDENCE_RANK_SAFEGUARD=10
RETRIEVAL_MIN_FINAL_CHUNKS=10
RETRIEVAL_MAX_FINAL_CHUNKS=15

# =============================================
# Embeddings
# =============================================
# BGE-M3 is downloaded from Hugging Face and cached in the named Docker volume.
EMBEDDING_MODEL_PATH=BAAI/bge-m3

# =============================================
# Frontend
# =============================================
VITE_API_BASE_URL=http://localhost:8080/api

# =============================================
# CORS (Backend)
# =============================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
QUALITY_REPORT_PATH=/data/quality-report.json
